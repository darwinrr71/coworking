generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/**
 * Role for the user
 */
enum Role {
  User
  Admin
}

/**
 * Type of reserved room
 */
enum RoomType {
  workspace
  conference
}

/**
 * Table User
 */
model User {
  id       Int       @id @default(autoincrement())
  username String    @unique
  password String
  role     Role      @default(User)
  bookings Booking[]
}

/**
 * Table Room
 */
model Room {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  capacity Int
  type     RoomType
  bookings Booking[]
}

/**
 * Table Booking
 */
model Booking {
  id        Int      @id @default(autoincrement())
  startTime DateTime
  endTime   DateTime
  roomId    Int
  room      Room     @relation(fields: [roomId], references: [id])
  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  @@index([roomId])
  @@index([userId])
}
